@*
    Include this partial inside a Razor view (NOT a layout) when the page needs:
      - Bootstrap 5 (for buttons, layout, collapses)
      - Awesomplete (for searchable dropdowns)
      - svg-pan-zoom (for SVG navigation)
      - the shared roslyn-graph-ui.js module
      - the shared graph-page CSS (loading overlay, panels, etc.)

    All Roslyn-graph UIs in this repo should pull these from the same partial so
    versions stay in lockstep.
*@
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/svg-pan-zoom@3.6.1/dist/svg-pan-zoom.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/awesomplete@1.1.5/awesomplete.min.js"></script>
<link href="https://cdn.jsdelivr.net/npm/awesomplete@1.1.5/awesomplete.css" rel="stylesheet">

<link rel="stylesheet" href="~/_content/RoslynGraphUi.Shared/css/graph-page.css" />
<script src="~/_content/RoslynGraphUi.Shared/js/roslyn-graph-ui.js"></script>
