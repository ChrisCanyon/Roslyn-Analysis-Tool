@using static MVCWebView.Controllers.HomeController
@using System.Text.Json
@{
    ViewData["Title"] = "Gateway Call Graph";
    ViewData["AppName"] = "MVCWebView";
    var actions = (List<ClassSelectItem>)ViewData["ControllerActions"]!;
    // Ship to JS as a JSON array of { display, value } so Awesomplete can do
    // its own substring matching against the namespace-bearing display string.
    // System.Text.Json defaults are HTML-safe.
    var actionsJson = JsonSerializer.Serialize(actions.Select(a => new { display = a.Display, value = a.Value }));
}

@await Html.PartialAsync("_GraphPageHead")
<style>
    /* Side-panel headers — accent so they pop against the black background. */
    .gp-header { color: #4fc3f7; letter-spacing: 0.02em; border-bottom: 1px solid #2a3442; padding-bottom: 4px; }
    /* Focus indicator under the current root. Yellow because focus is a
       transient mode the user should notice they're in. */
    .focus-banner {
        background: #2a2520; border-left: 3px solid #ffd54f;
        padding: 4px 8px; margin: 4px 0;
        font-size: 11px; color: #cfd8dc; word-break: break-all;
    }
    .focus-banner .focus-label { color: #ffd54f; font-weight: bold; margin-right: 4px; }
    .focus-banner .focus-target { color: #ffd54f; }
    .focus-banner .focus-clear { color: #4fc3f7; margin-left: 6px; text-decoration: none; font-size: 10px; }
    .focus-banner .focus-clear:hover { color: #81d4fa; text-decoration: underline; }
    /* Export-current-view control. Sits under the focus banner; the status line
       below it shows the destination folder after a successful export, or an
       error message in red on failure. */
    .export-controls { margin: 6px 0; }
    .export-btn { background: #2e7d32; color: white; border: none; padding: 4px 10px; border-radius: 3px; cursor: pointer; font-size: 11px; }
    .export-btn:disabled { background: #2a3442; color: #607d8b; cursor: default; }
    .export-btn:not(:disabled):hover { background: #388e3c; }
    .export-status { font-size: 10px; color: #90a4ae; margin-top: 4px; word-break: break-all; }
    .export-status.success { color: #81c784; }
    .export-status.error { color: #ef5350; }
    /* Per-interface impls picker (side panel). One dropdown per interface
       with multiple in-source impls; user picks one concrete class per
       interface and commits the batch via Apply. Selections survive
       navigation, the rendered graph reflects the latest committed picks. */
    .ii-controls { display: flex; gap: 8px; margin-bottom: 6px; align-items: center; }
    .ii-apply { background: #1565c0; color: white; border: none; padding: 3px 10px; border-radius: 3px; cursor: pointer; font-size: 11px; }
    .ii-apply:disabled { background: #2a3442; color: #607d8b; cursor: default; }
    .ii-apply:not(:disabled):hover { background: #1976d2; }
    .ii-reset { background: transparent; color: #90a4ae; border: 1px solid #2a3442; padding: 3px 10px; border-radius: 3px; cursor: pointer; font-size: 11px; }
    .ii-reset:hover { color: #ef5350; border-color: #ef5350; }
    .ii-empty { color: #607d8b; font-style: italic; font-size: 11px; }
    .ii-iface { margin-bottom: 8px; }
    .ii-iface-header-static {
        color: #cfd8dc; padding: 3px 0; word-break: break-all; font-size: 11px;
    }
    .ii-select {
        width: 100%; background: #1a1f26; color: #cfd8dc;
        border: 1px solid #2a3442; border-radius: 3px;
        padding: 3px 4px; font-size: 11px;
    }
    .ii-select:focus { outline: 1px solid #4fc3f7; }
    .ii-select-pending { border-color: #ffd54f; box-shadow: 0 0 0 1px #ffd54f44; }
    .ii-pending-badge { background: #ffd54f; color: black; border-radius: 8px; padding: 0 6px; font-size: 10px; margin-left: 4px; }
    /* Call-count severity scale. degree 0 stays neutral; N is yellow; each
       additional power gets hotter. The pre containers are already monospace. */
    .cc-row    { display: block; }
    .cc-name   { color: #cfd8dc; }
    .cc-formula { font-weight: bold; }
    .cc-d0     { color: #90a4ae; }            /* constant — no signal */
    .cc-d1     { color: #ffd54f; }            /* N — yellow */
    .cc-d2     { color: #ff9800; }            /* N^2 — orange */
    .cc-d3     { color: #ef5350; }            /* N^3 — red */
    .cc-d4     { color: #ff1744; text-shadow: 0 0 4px #ff1744aa; } /* N^4+ — really bad */
    .cat-ext   { color: #ef9a9a; }
    .cat-dat   { color: #90caf9; }
</style>
<script>
    window.controllerActions = @Html.Raw(actionsJson);
</script>
<script src="~/js/Views/Home/callgraph.js" asp-append-version="true"></script>

@await Html.PartialAsync("_LoadingOverlay")

<div class="bg-light p-2 border-bottom" style="position: relative; height: 55px; z-index: 100;">
    <div style="position: absolute; left: 0; padding-left: 1em;">
        <button class="btn btn-outline-secondary" onclick="loadPrevious()">&lt; Back</button>
    </div>
    <div class="d-flex align-items-center gap-2" style="position: absolute; left: 50%; transform: translateX(-50%);">
        <input id="controllerInput" class="form-control" style="width: 720px"
               placeholder="Type any part of the namespace, controller, or method..." autocomplete="off" />
        <button class="btn btn-outline-primary" style="width: max-content;" onclick="loadController()">Load Graph</button>
        <div class="form-check form-switch" style="white-space: nowrap; margin-left: 0.75rem;" title="When on, the walker keeps descending into a node's body even after tagging it as a boundary. The graph gets much larger.">
            <input class="form-check-input" type="checkbox" id="expandToggle" onchange="onExpandToggleChanged()" />
            <label class="form-check-label" for="expandToggle">Expand past boundaries</label>
        </div>
    </div>
    <div class="d-flex align-items-center gap-2" style="position: absolute; right: 0; padding-right: 1em;">
        <a class="btn btn-outline-secondary" href="/">Dependency UI</a>
    </div>
</div>

<div class="container-fluid overflow-hidden">
    <div class="d-flex flex-row" style="height: calc(100vh - 70px);">
        <div id="graphPanel" class="flex-grow-1 overflow-auto p-3 bg-white">
            <div id="svgContainer" style="height: 100%; overflow: auto;">
                <div id="svgOutput" style="height: 100%">
                    Pick a controller action above to render its call graph down to the gateways it reaches.
                </div>
            </div>
        </div>

        <div class="bg-black text-light p-3" style="overflow: auto; max-height: 100%; max-width: 28vw;">
            <div class="pre-wrap-container mono p-2 bg-black text-light">
                <h5 class="gp-header">Current root</h5>
                <pre id="currentRoot">(none)</pre>

                <div id="focusBanner" class="focus-banner" style="display: none;">
                    <span class="focus-label">Focused on:</span>
                    <span class="focus-target"></span>
                    <a href="javascript:void(0)" class="focus-clear" onclick="clearFocus()">[clear]</a>
                </div>

                <div class="export-controls">
                    <button class="export-btn" id="exportBtn" onclick="exportCurrentView()" disabled
                            title="Dump SVG + raw JSON + metadata to disk for offline analysis">
                        Export current view
                    </button>
                    <div id="exportStatus" class="export-status"></div>
                </div>

                <h5 class="gp-header mt-3">Stats</h5>
                <pre id="graphStats">(empty)</pre>

                <h5 class="gp-header mt-3">
                    Interface impls
                    <span id="iiPendingBadge" class="ii-pending-badge" style="display:none;">0</span>
                </h5>
                <div class="ii-controls">
                    <button class="ii-apply" id="iiApplyBtn" onclick="applyImplChanges()" disabled>Apply</button>
                    <button class="ii-reset" onclick="resetImplChanges()">Reset all</button>
                </div>
                <div id="interfaceImplList" class="ii-empty">(none — load a graph that has interfaces with impls)</div>

                <h5 class="gp-header mt-3">Boundary call counts</h5>
                <pre id="boundaryCallCounts">(none)</pre>

                <h5 class="gp-header mt-3">Loop edges</h5>
                <pre id="loopList">(none)</pre>

                <h5 class="gp-header mt-3">Conditional edges</h5>
                <pre id="conditionalList">(none)</pre>
            </div>
        </div>
    </div>
</div>
